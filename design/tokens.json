{
  "$comment": "Single source of truth for the look of every app built on the base platform. Values are the ones that ship in Burrow 3.3 (Android-Showcase, ui/theme/Theme.kt and ui/hand/HandUi.kt). Edit here, then run `dart run base_tool:gen`. Never hand-edit the generated files.",
  "name": "Hand-drawn minimal",
  "version": "1.0.0",
  "color": {
    "light": {
      "paper":     { "value": "#FFFFFF",   "use": "Page background. No cards: content sits straight on the paper." },
      "ink":       { "value": "#1A1A1A",   "use": "Text, doodles, the one primary (ink) button." },
      "pencil":    { "value": "#6B6B6B",   "use": "Secondary text and meta lines." },
      "graphite":  { "value": "#A3A3A3",   "use": "Disabled text, placeholders, faded photos." },
      "rule":      { "value": "#261A1A1A", "use": "Sketchy hairline dividers (ink at 15%). ARGB." },
      "smudge":    { "value": "#F4F3EF",   "use": "The only fill: input wells, placeholders, done notes." },
      "marker":    { "value": "#FFE45C",   "use": "The one accent: a highlighter swipe behind ONE word per screen." },
      "markerInk": { "value": "#1A1A1A",   "use": "Text on the marker, always ink." },
      "redPen":    { "value": "#DC2626",   "use": "Private or destructive things only." }
    },
    "dark": {
      "paper":     { "value": "#1E1D1B",   "use": "Warm charcoal night notebook, not black: thin strokes do not bloom." },
      "ink":       { "value": "#E8E3D8",   "use": "Chalky ink, about 12:1 on paper." },
      "pencil":    { "value": "#B9B3A8" },
      "graphite":  { "value": "#948E84",   "use": "Still 4.5:1 on paper." },
      "rule":      { "value": "#4DE8E3D8", "use": "Ink at 30%. ARGB." },
      "smudge":    { "value": "#2D2B28" },
      "marker":    { "value": "#D9BF45" },
      "markerInk": { "value": "#1E1D1B" },
      "redPen":    { "value": "#FF8A80" }
    },
    "series": ["#1A1A1A", "#8A6D1F", "#3E6B5A", "#7A4A6B", "#4A5E85", "#9A4B3C", "#5F6B2E", "#6B6B6B"]
  },
  "font": {
    "hand": "Caveat",
    "voices": [
      { "id": "formal",      "label": "formal",          "note": "Inter, a crisp sans",        "family": "Inter",        "informality": null, "scale": 1.0 },
      { "id": "friendly",    "label": "friendly",        "note": "Nunito, a rounded sans",     "family": "Nunito",       "informality": null, "scale": 1.02 },
      { "id": "neat",        "label": "neat hand",       "note": "Shantell Sans, marker-neat", "family": "ShantellSans", "informality": 0,    "scale": 0.98 },
      { "id": "loose",       "label": "loose hand",      "note": "Shantell Sans, informal",    "family": "ShantellSans", "informality": 100,  "scale": 0.98 },
      { "id": "handwritten", "label": "all handwritten", "note": "Patrick Hand",               "family": "PatrickHand",  "informality": null, "scale": 1.14 }
    ],
    "defaultVoice": "neat"
  },
  "type": {
    "hand": {
      "display":  { "size": 52, "lineHeight": 54, "weight": 700, "letterSpacing": -0.01 },
      "headline": { "size": 40, "lineHeight": 42, "weight": 700 },
      "title":    { "size": 30, "lineHeight": 33, "weight": 700 },
      "door":     { "size": 26, "lineHeight": 30, "weight": 600 },
      "label":    { "size": 21, "lineHeight": 24, "weight": 600 },
      "small":    { "size": 18, "lineHeight": 21, "weight": 600 }
    },
    "body": {
      "bodyLarge": { "size": 16, "lineHeight": 23, "weight": 400 },
      "body":      { "size": 15, "lineHeight": 22, "weight": 400 },
      "meta":      { "size": 13, "lineHeight": 18, "weight": 400 },
      "mono":      { "size": 12, "lineHeight": 16, "weight": 400 }
    }
  },
  "space": { "xs": 4, "s": 8, "m": 16, "l": 24, "xl": 40, "xxl": 64, "gutter": 24, "maxColumn": 560, "twoPaneBreakpoint": 700 },
  "radius": { "pill": 999, "snapshot": 2, "well": 14, "row": 10, "block": 16 },
  "stroke": { "hairline": 1.2, "underline": 1.6, "pill": 1.6, "circle": 1.8, "doodle": 2.0, "progressTrack": 2.0, "progressInk": 3.0 },
  "motion": { "quick": 150, "toggle": 220, "base": 250, "progress": 400, "circle": 450, "draw": 600 },
  "alpha": { "disabledButton": 0.35, "disabledLink": 0.4, "faded": 0.38 },
  "elevation": { "snapshot": 2 }
}
